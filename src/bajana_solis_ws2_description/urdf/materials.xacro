<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="yellow_rgba" value="0.9803921569 0.8 0.0823529412 1" />
  <xacro:property name="silver_rgba" value="0.6666666667 0.7058823529 0.7529411765 1" />
  <xacro:property name="graphite_rgba" value="0.1254901961 0.1411764706 0.1725490196 1" />
  <xacro:property name="blue_rgba" value="0.1450980392 0.3882352941 0.9215686275 1" />
  <material name="blue">
    <color rgba="${blue_rgba}" />
  </material>
  <material name="graphite">
    <color rgba="${graphite_rgba}" />
  </material>
  <material name="silver">
    <color rgba="${silver_rgba}" />
  </material>
  <material name="yellow">
    <color rgba="${yellow_rgba}" />
  </material>
</robot>
