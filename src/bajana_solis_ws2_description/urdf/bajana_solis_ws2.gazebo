<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gazebo_color" params="link rgba">
    <gazebo reference="${link}">
      <visual>
        <material>
          <ambient>${rgba}</ambient>
          <diffuse>${rgba}</diffuse>
        </material>
      </visual>
    </gazebo>
  </xacro:macro>
  <xacro:gazebo_color link="r_wheel_1" rgba="${graphite_rgba}" />
  <xacro:gazebo_color link="l_wheel_1" rgba="${graphite_rgba}" />
  <xacro:gazebo_color link="castor_1" rgba="${graphite_rgba}" />
  <xacro:gazebo_color link="camera_1" rgba="${yellow_rgba}" />
  <xacro:gazebo_color link="lidar_1" rgba="${silver_rgba}" />
  <xacro:gazebo_color link="base_link" rgba="${blue_rgba}" />
  <gazebo reference="base_link">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="l_wheel_1">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="r_wheel_1">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="castor_1">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>l_join</left_joint>
      <right_joint>r_join</right_joint>
      <wheel_separation>0.18</wheel_separation>
      <wheel_radius>0.0375</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.2</max_linear_velocity>
      <min_linear_velocity>-0.2</min_linear_velocity>
      <max_angular_velocity>0.8</max_angular_velocity>
      <min_angular_velocity>-0.8</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>l_join</joint_name>
      <joint_name>r_join</joint_name>
    </plugin>
  </gazebo>
</robot>
